# Token integrasi Notion — buat di https://www.notion.so/profile/integrations
# (Internal Integration Secret, diawali "secret_")
NOTION_TOKEN=

# ID database memori — akan otomatis diisi jika kamu menjalankan:
#   npm run init-db -- <url-page-induk>
NOTION_DATABASE_ID=
# Optional for a database with one data source; required when it has multiple.
NOTION_DATA_SOURCE_ID=

# Opsional: lokasi SQLite yang sama untuk semua MCP client/CLI.
# Gunakan path absolut; jika kosong, default ke .cache/memory.sqlite di root instalasi.
MEMORY_CACHE_PATH=
