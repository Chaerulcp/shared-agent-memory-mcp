{
  "name": "@chaerulcp/shared-agent-memory-mcp",
  "version": "1.6.1",
  "description": "Memori bersama (shared memory) untuk AI coding agents — Cline, OpenCode, Claude Code, GitHub Copilot, Hermes — dengan penyimpanan di Notion",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chaerulcp/shared-agent-memory-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Chaerulcp/shared-agent-memory-mcp/issues"
  },
  "homepage": "https://github.com/Chaerulcp/shared-agent-memory-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-memory",
    "notion",
    "obsidian",
    "coding-agents"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "bin": {
    "agent-memory": "dist/cli.js",
    "notion-memory": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "setup": "node dist/cli.js setup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "init-db": "node dist/cli.js init",
    "doctor": "node dist/cli.js doctor",
    "sync": "node dist/cli.js sync",
    "watch": "node dist/cli.js watch --interval 300",
    "test": "npm run build && node --test test/*.test.mjs",
    "benchmark:retrieval": "node bench/retrieval-benchmark.mjs",
    "prepublishOnly": "npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@notionhq/client": "^5.26.0",
    "better-sqlite3": "^13.0.3",
    "lru-cache": "^11.0.2",
    "sqlite-vec": "^0.1.4",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "0.35.4",
    "adm-zip": "0.6.1"
  }
}
