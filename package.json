{
  "name": "shared-agent-memory-mcp",
  "version": "1.1.2",
  "description": "Memori bersama (shared memory) untuk AI coding agents — Cline, OpenCode, Claude Code, GitHub Copilot, Hermes — dengan penyimpanan di Notion",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-memory": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "setup": "node dist/cli.js setup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "cli": "node dist/cli.js",
    "init-db": "node dist/cli.js init",
    "doctor": "node dist/cli.js doctor",
    "sync": "node dist/cli.js sync",
    "watch": "node dist/cli.js watch --interval 300",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@notionhq/client": "^2.2.15",
    "better-sqlite3": "^13.0.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
